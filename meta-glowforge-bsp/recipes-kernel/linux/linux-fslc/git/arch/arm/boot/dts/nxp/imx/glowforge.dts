// SPDX-License-Identifier: GPL-2.0
/*
 * Glowforge Control Board: ForgeFIRM device tree for linux-fslc 6.12 (mainline).
 *
 * The factory 4.14 glowforge.dts, carried onto mainline bindings. Peripherals
 * that bind to in-tree drivers: UART console, eMMC/SD, fixed regulators,
 * gpio-leds / gpio-keys, the I2C sensors (st,lis2hh12 x3, national,lm75b), the
 * WL1805 SDIO wifi, and the fan/laser PWMs. The motion path (&epit1/&epit2 and
 * the glowforge,cnc/thermal/pic/head nodes) binds to glowforge.ko through the
 * EPIT and SDMA layer patches; the laser PWM carries the factory
 * fsl,extra-prescale (patch 0009). The cameras run on the mainline ov5648 /
 * ov8856 subdevs behind video-mux, imx6-mipi-csi2 and imx-media, in place of
 * the factory ov5648_mipi driver and mxc_v4l2 nodes. The factory
 * glowforge,imx-pwm-audio buzzer node is not part of ForgeFIRM.
 *
 * Copyright 2020-2026 514 LLC d/b/a OpenGlow
 * Written by Scott Wiederhold
 * Copyright (C) 2015 Glowforge, Inc. <opensource@glowforge.com>
 */
/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "imx6dl.dtsi"
#include "openglow_common.dtsi"

/ {
	model = "Glowforge Control Board Core";
	compatible = "glowforge,imx6dl-glowforge", "fsl,imx6dl";

	/* The Solo has one core: drop the second CPU node of the base include. */
	cpus {
		/delete-node/ cpu@1;
	};

	chosen {
		/*
		 * Fallback only: U-Boot always overwrites bootargs from its
		 * environment (mmcargs carries the real root=). No root= here -
		 * a boot that ever fell through to this would stop at a visible
		 * rootfs panic instead of silently booting a hardcoded slot -
		 * and no quiet: the recovery ladder ends at the serial console,
		 * which must show the early boot output.
		 */
		bootargs = "console=ttymxc0,115200";
	};

	/*
	 * Memory reserved for DMA: a dedicated pool for the cnc SDMA pulse ring
	 * plus the default CMA for camera/IPU/VPU capture buffers - 96 MiB total
	 * on the 512 MB SOM, leaving ~454 MiB to Linux.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/*
		 * Dedicated, EXCLUSIVE coherent pool for the cnc SDMA pulse ring
		 * (glowforge,cnc references it via memory-region below; cnc.c calls
		 * of_reserved_mem_device_init()). Pulling the ring from the shared CMA
		 * fails once boot has fragmented it (cma_alloc -EBUSY) because the
		 * out-of-tree module probes late; a non-reusable shared-dma-pool
		 * (which must be no-map) is never touched by movable allocations and,
		 * size-aligned, satisfies dma_alloc_coherent() deterministically.
		 *
		 * Sizing: the grblHAL live feed keeps only a few KB in flight; legacy
		 * cloud mode preloads a job's ENTIRE pulse file into the ring, so the
		 * pool caps cloud-mode job length (~1 MiB per 100 s of 10 kHz
		 * stream; 32 MiB = ~56 min, matching the factory ring). The module's
		 * ring_mb parameter must fit this pool - raise both for longer cloud
		 * jobs. no-map means the whole pool leaves the kernel's memory map at
		 * boot whether the ring uses it or not; on the 512 MB SOM that is
		 * affordable and buys a deterministic allocation.
		 */
		cnc_reserved: cnc-pulsebuf {
			compatible = "shared-dma-pool";
			no-map;
			size = <0x02000000>;      /* 32 MiB */
			alignment = <0x02000000>; /* size-aligned base */
		};

		/*
		 * Reusable CMA for camera/IPU/VPU capture buffers (default area).
		 * A 2592x1944 SBGGR8 frame is ~5 MiB and an 8 MP machine's
		 * 3264x2448 one is ~8 MiB, so the deepest capture queue is ~32 MiB;
		 * 64 MiB leaves room for that plus the VPU JPEG contexts.
		 */
		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x04000000>;      /* 64 MiB */
			linux,cma-default;
		};

		/*
		 * Crash record (pstore/ramoops). PANIC_ON_OOPS plus the ten-second
		 * panic timeout reboot the machine after any oops; the oops text
		 * and the last 256 KiB of console survive here and come back on the
		 * next boot under /sys/fs/pstore. The region is the 1 MiB at the top
		 * of DRAM that the bootloader already holds back from the memory
		 * node (its pstore_addr/pstore_size), so it costs no Linux memory;
		 * no-map keeps it out of the kernel map and pstore maps it uncached.
		 * 32 KiB dump records with 16-byte ECC blocks, so a torn record is
		 * detected instead of trusted.
		 */
		ramoops@2ff00000 {
			compatible = "ramoops";
			reg = <0x2ff00000 0x100000>;
			no-map;
			record-size = <0x8000>;
			console-size = <0x40000>;
			ecc-size = <16>;
		};
	};

	regulators {
		compatible = "simple-bus";

		reg_3p3v: 3p3v {
			compatible = "regulator-fixed";
			regulator-name = "3p3v";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-always-on;
		};

		reg_wlan: wlan-vbus {
			compatible = "regulator-fixed";
			regulator-name = "wlan-en-regulator";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			/* WLAN_EN GPIO */
			gpio = <&gpio5 26 0>;
			/* WLAN card specific delay */
			startup-delay-us = <70000>;
			enable-active-high;
		};

		reg_12v: 12v {
			compatible = "regulator-fixed";
			enable-active-high;
			regulator-boot-on;
			gpio = <&gpio5 8 0>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_12v>;
			regulator-name = "12v";
			regulator-min-microvolt = <12000000>;
			regulator-max-microvolt = <12000000>;
			regulator-always-on;
		};

		reg_40v: 40v {
			compatible = "regulator-fixed";
			enable-active-high;
			gpio = <&gpio5 17 0>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_40v>;
			regulator-name = "40v";
			regulator-min-microvolt = <40000000>;
			regulator-max-microvolt = <40000000>;
		};

		/*
		 * The 12 V control rail has no userspace consumer node: it is
		 * always-on above, and nothing in the firmware switches it.
		 */
	};

	/* outputs control */
	outputs {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_outputs>;

		camera_mux_oe {
			label = "camera_mux_oe";
			gpios = <&gpio6 7 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
	};

	/* switches */
	switches {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_switches>;

		door1 {
			label = "door1";
			gpios = <&gpio4 14 GPIO_ACTIVE_LOW>;
			debounce-interval = <5>;
			linux,code = <0>;
			linux,input-type = <5>; /* EV_SW */
		};
		door2 {
			label = "door2";
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <5>;
			linux,code = <1>;
			linux,input-type = <5>; /* EV_SW */
		};
		button {
			label = "button";
			gpios = <&gpio4 9 GPIO_ACTIVE_LOW>;
			debounce-interval = <20>;
			linux,code = <2>;
			linux,input-type = <5>; /* EV_SW */
		};
		doors {
			label = "doors";
			gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;
			debounce-interval = <5>;
			linux,code = <3>;
			linux,input-type = <5>; /* EV_SW */
		};
		/* Readback of the safety chain's HV_ENABLE output, through the
		 * U24 inverter (the pin carries /HV_ENABLE, hence active-low).
		 * Not an input: it is a monitor of what the chain decided.
		 * The factory design calls this net E-STOP. */
		hv_enable {
			label = "hv_enable";
			gpios = <&gpio4 6 GPIO_ACTIVE_LOW>;
			debounce-interval = <5>;
			linux,code = <4>;
			linux,input-type = <5>; /* EV_SW */
		};
		interlock {
			label = "interlock";
			gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
			debounce-interval = <5>;
			linux,code = <5>;
			linux,input-type = <5>; /* EV_SW */
		};
		interlock_latch {
			label = "interlock_latch";
			gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>;
			debounce-interval = <5>;
			linux,code = <6>;
			linux,input-type = <5>; /* EV_SW */
		};
		head {
			label = "head";
			gpios = <&gpio3 22 GPIO_ACTIVE_HIGH>;
			debounce-interval = <60>; /* ignore pulses when head reboots */
			linux,code = <7>;
			linux,input-type = <5>; /* EV_SW */
		};
	};

	/* stepper driver + laser fire (glowforge,cnc -> glowforge.ko) */
	cnc {
		compatible = "glowforge,cnc";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_cnc>;
		memory-region = <&cnc_reserved>; /* dedicated SDMA pulse ring pool */
		/* 40 V stepper rail, exclusive consumer (stepper power on/off).
		 * Mandatory: without this mapping devm_regulator_get_exclusive()
		 * returns -ENODEV on mainline. (The factory 3.14 kernel resolved
		 * the bare name "40v" via the regulator core's lookup-by-name
		 * fallback, which mainline later removed; the factory DTB has no
		 * 40v-supply property either.) */
		40v-supply         = <&reg_40v>;
		latch-reset-gpio   = <&gpio1 7 0>; /* BUTTON_LATCH_RST */
		z-dir-gpio         = <&gpio2 17 0>;
		y1-dir-gpio        = <&gpio2 18 0>;
		x-dir-gpio         = <&gpio2 19 0>;
		y1-step-gpio       = <&gpio2 20 0>;
		z-step-gpio        = <&gpio2 21 0>;
		x-step-gpio        = <&gpio2 22 0>;
		y2-dir-gpio        = <&gpio2 28 0>;
		y2-step-gpio       = <&gpio2 29 0>;
		laser-enable-gpio  = <&gpio2 30 0>;
		laser-on-head-gpio = <&gpio2 31 0>;
		/* laser-safety-chain readbacks (glowforge.ko cnc_get_* attrs) */
		laser-on-gpio      = <&gpio1 5 0>;
		button-latch-gpio  = <&gpio1 3 0>;
		laser-pgood-gpio   = <&gpio4 21 0>;
		interlock-latch-reset-gpio = <&gpio4 5 0>;
		charge-pump-alive-gpio = <&gpio1 8 0>;
		x-mode1-gpio       = <&gpio3 1 0>;
		y1-enable-gpio     = <&gpio3 2 0>;
		x-mode2-gpio       = <&gpio3 3 0>;
		y-mode0-gpio       = <&gpio3 4 0>;
		x-mode0-gpio       = <&gpio3 5 0>;
		x-home-gpio        = <&gpio3 6 0>;
		y-decay-gpio       = <&gpio3 7 0>;
		y1-fault-gpio      = <&gpio3 8 0>;
		y2-home-gpio       = <&gpio3 9 0>;
		y1-home-gpio       = <&gpio3 10 0>;
		y2-enable-gpio     = <&gpio3 11 0>;
		y-mode1-gpio       = <&gpio3 12 0>;
		y-mode2-gpio       = <&gpio3 13 0>;
		y2-fault-gpio      = <&gpio3 14 0>;
		sleep-gpio         = <&gpio3 16 0>;
		z-enable-gpio      = <&gpio3 17 0>; /* NC; unused */
		reset-gpio         = <&gpio3 18 0>;
		x-decay-gpio       = <&gpio3 23 0>;
		charge-pump-gpio   = <&gpio3 24 0>;
		x-fault-gpio       = <&gpio3 26 0>;
		x-enable-gpio      = <&gpio3 27 0>;
		beam-reset-gpio    = <&gpio7 13 0>; /* unused; only v13 and v14 */
		/* 6.12: laser PWM via DT phandle (was laser-pwm=<1>); driver sets the
		 * real period, so the cell value here is a placeholder. */
		pwms               = <&pwm2 0 100000 0>;
		pwm-names          = "laser-pwm";
		timer              = <&epit1>;
		/* SDMA channel 26; script origin 0xF00 (32-bit words) = halfword
		 * 7680. The factory used 0xe00 (halfword 7168), which the NXP
		 * sdma-imx6q.bin RAM firmware (v3.6: halfwords 6144-7520) overlaps;
		 * whichever loaded last would silently corrupt the other. SDMA RAM
		 * spans halfwords 4096-8191 (8 KB; IMX6SDLRM SDMA memory map: RAM =
		 * words 0x0800-0x0FFF), so the script at 7680-7819 clears that
		 * firmware with 372 halfwords of RAM headroom left above it, and
		 * glowforge.ko verifies/reloads the script before every run. The
		 * engine runs its ROM scripts by design: the built-in imx-sdma probes
		 * before the rootfs is mounted, every SDMA client on this board uses
		 * ROM scripts (the pulse script is the module's own), and the image
		 * ships no SDMA RAM firmware. */
		sdma-params        = <26 0xF00>;
	};

	/* coolant/fans/TEC (glowforge,thermal -> glowforge.ko) */
	thermal {
		compatible = "glowforge,thermal";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_thermal>;
		intake1-tach-gpio = <&gpio4 20 0>;
		intake2-tach-gpio = <&gpio4 23 0>;
		exhaust-tach-gpio = <&gpio2 8 0>;
		water-pump-gpio   = <&gpio6 8 0>;
		water-heater-gpio = <&gpio7 9 0>;
		tec-gpio          = <&gpio6 10 0>;
		/* 6.12: fan PWMs via DT phandles (were intake-pwm=<0>, exhaust-pwm=<2>);
		 * 25 kHz => 40000 ns. */
		pwms              = <&pwm1 0 40000 0>, <&pwm4 0 40000 0>;
		pwm-names         = "intake-pwm", "exhaust-pwm";
	};

	/* ===== Cameras (lid + head sensors behind the CAM_SEL MIPI switch) =====
	 * Replaces the factory v4l2_int_device ov5648_mipi driver with the mainline
	 * ov5648 subdev + imx6 IPU/MIPI-CSI2 (imx-media) pipeline. The factory
	 * CAM_SEL GPIO selects which sensor's MIPI CSI-2 stream reaches the shared
	 * imx6-mipi-csi2 receiver; modeled with the mainline video-mux.
	 *
	 * Verified against the factory firmware DTB (imx6dl-glowforge-v20): the
	 * sensor xvclk is a 24 MHz fixed oscillator; CSI-2 uses 2 data lanes;
	 * CAM_SEL is gpio7-10 active-high; the mux output-enable is gpio6-7
	 * active-low (default on); there are no per-sensor reset/powerdown GPIOs
	 * (the rails are always-on and the sensors are gated via the mux OE). The
	 * dvdd/dovdd/avdd fixed regulators below are not in the factory tree but the
	 * mainline ov5648 driver requires them, so they are modeled always-on.
	 *
	 * Both sensors are bound via a dual "ovti,ov8856","ovti,ov5648" compatible
	 * (matching the factory DTB) so one image covers standard (5 MP OV5648) and
	 * "HD" (8 MP OV8856) units; the driver that matches the chip-id wins (the
	 * other one's probe fails on the chip-id read and the device is offered to
	 * the next matching driver).
	 *
	 * The endpoint link-frequencies list must contain every entry of the bound
	 * driver's menu for the lane count in use: ov8856_get_hwcfg rejects the
	 * endpoint outright if any of its 2-lane menu {720, 360} MHz is missing,
	 * while ov5648 only needs the rate a given mode actually uses. Hence the
	 * four values below - ov5648 {210, 168} MHz plus ov8856 {720, 360} MHz.
	 *
	 * OV8856 note: the sensor's RAW10 full-resolution 2-lane mode runs the
	 * link at 720 MHz (1.44 Gbps/lane) and the i.MX6 CSI-2 D-PHY tops out at
	 * 1 Gbps/lane, so imx6-mipi-csi2 refuses to program it. Full resolution
	 * is reached instead through the RAW8 3264x2448 mode, which carries the
	 * frame at 360 MHz like the binned modes do; 720 MHz stays in the list
	 * only because ov8856_get_hwcfg checks the whole 2-lane menu. The 24 MHz
	 * xvclk (the board's oscillator, per the factory DTB) is handled by the
	 * ov8856 PLL retune patch; without it the driver would run the link 25%
	 * above the frequency it publishes.
	 */
	clk_cam_xvclk: clock-cam-xvclk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>; /* 24 MHz sensor oscillator (per factory DTB) */
	};

	reg_cam_2v8: regulator-cam-2v8 {
		compatible = "regulator-fixed";
		regulator-name = "cam_avdd_2v8";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-always-on;
	};

	reg_cam_1v8: regulator-cam-1v8 {
		compatible = "regulator-fixed";
		regulator-name = "cam_dovdd_1v8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
	};

	reg_cam_1v5: regulator-cam-1v5 {
		compatible = "regulator-fixed";
		regulator-name = "cam_dvdd_1v5";
		regulator-min-microvolt = <1500000>;
		regulator-max-microvolt = <1500000>;
		regulator-always-on;
	};

	/* Factory CAM_SEL line (gpio7 10): 0 = lid (A), 1 = head (B). */
	cam_mux: mux-controller {
		compatible = "gpio-mux";
		#mux-control-cells = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_cam_mux>;
		mux-gpios = <&gpio7 10 GPIO_ACTIVE_HIGH>;
	};

	video-mux {
		compatible = "video-mux";
		mux-controls = <&cam_mux>;
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			vmux_in_lid: endpoint {
				remote-endpoint = <&ov5648_lid_ep>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
			};
		};
		port@1 {
			reg = <1>;
			vmux_in_head: endpoint {
				remote-endpoint = <&ov5648_head_ep>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
			};
		};
		port@2 {
			reg = <2>;
			vmux_out: endpoint {
				remote-endpoint = <&mipi_csi2_in>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
			};
		};
	};
};

&ecspi2 {
	fsl,spi-num-chipselects = <1>;
	/* PIC /CS is active-low. The 4.14 SPI core ignored the cs-gpios cell flag
	 * and always treated GPIO chip-selects as active-low; since the gpiod
	 * conversion (~v5.1) the core honors the flag, so an active-high cell (0)
	 * now drives CS the wrong way and the PIC reads back 0x0000. */
	cs-gpios = <&gpio4 16 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_ecspi2>;
	/* PIO only. The PIC transactions are 3 bytes and spi-imx would use DMA
	 * from 64 bytes up; without the SoC's dmas the controller holds no SDMA
	 * channels and the pulse ring stays the SDMA's only client, which the
	 * step-timing margin assumes. (ECSPI TX DMA would also need a RAM SDMA
	 * script the image does not ship.) The engine's ipg/ahb clocks are then
	 * held by glowforge.ko alone (sdma_get_channel in the SDMA API patch);
	 * no other client keeps them on. */
	/delete-property/ dmas;
	/delete-property/ dma-names;
	status = "okay";

	/* PIC sensor MCU (glowforge,pic -> glowforge.ko) */
	pic: spi@0 {
		compatible = "glowforge,pic";
		/* Datasheet indicates max SCLK frequency is about 3.44MHz */
		spi-max-frequency = <1000000>;
		reg = <0>;
	};
};

/* Lid I2C Bus */
&i2c1 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c1>;
	status = "okay";

	/* LID CAMERA: OV5648 (5 MP) or OV8856 (8 MP, "HD" units) -> video-mux in 0.
	 * Dual compatible per the factory DTB: ov8856 is tried first and falls back
	 * to ov5648 on I2C chip-id mismatch. */
	ov5648_lid: camera@36 {
		compatible = "ovti,ov8856", "ovti,ov5648";
		reg = <0x36>;
		clocks = <&clk_cam_xvclk>;
		clock-names = "xvclk";
		clock-frequency = <24000000>; /* ov8856 reads this property directly */
		dvdd-supply = <&reg_cam_1v5>;
		dovdd-supply = <&reg_cam_1v8>;
		avdd-supply = <&reg_cam_2v8>;
		port {
			ov5648_lid_ep: endpoint {
				remote-endpoint = <&vmux_in_lid>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
				bus-type = <4>; /* MEDIA_BUS_TYPE_CSI2_DPHY */
				/* union of both drivers' 2-lane menus:
				 * ov5648 {210,168} + ov8856 {720,360} MHz */
				link-frequencies = /bits/ 64 <168000000 210000000 360000000 720000000>;
			};
		};
	};

	/* LID ACCELEROMETER
	 * Supplies and mount-matrix are declared to keep the st_accel probe
	 * quiet: the 3.3 V rail models the harness feed, and the identity
	 * matrix is explicit because consumers work in raw counts. */
	lid-accel@1e {
		reg = <0x1e>;
		compatible = "st,lis2hh12";
		vdd-supply = <&reg_3p3v>;
		vddio-supply = <&reg_3p3v>;
		mount-matrix = "1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "1";
	};
};

/* No consumer. */
&i2c2 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c2>;
	status = "disabled";
};

/* Head I2C */
&i2c4 {
	clock-frequency = <100000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i2c4>;
	status = "okay";

	/* HEAD CAMERA: OV5648 (5 MP) or OV8856 (8 MP, "HD" units) -> video-mux in 1.
	 * Dual compatible per the factory DTB (see lid camera above). */
	ov5648_head: camera@36 {
		compatible = "ovti,ov8856", "ovti,ov5648";
		reg = <0x36>;
		clocks = <&clk_cam_xvclk>;
		clock-names = "xvclk";
		clock-frequency = <24000000>; /* ov8856 reads this property directly */
		dvdd-supply = <&reg_cam_1v5>;
		dovdd-supply = <&reg_cam_1v8>;
		avdd-supply = <&reg_cam_2v8>;
		port {
			ov5648_head_ep: endpoint {
				remote-endpoint = <&vmux_in_head>;
				clock-lanes = <0>;
				data-lanes = <1 2>;
				bus-type = <4>; /* MEDIA_BUS_TYPE_CSI2_DPHY */
				/* union of both drivers' 2-lane menus:
				 * ov5648 {210,168} + ov8856 {720,360} MHz */
				link-frequencies = /bits/ 64 <168000000 210000000 360000000 720000000>;
			};
		};
	};

	/* Head MCU (glowforge,head -> glowforge.ko) */
	head@47 {
		reg = <0x47>;
		compatible = "glowforge,head";
	};

	/* INTERCONNECT TEMP SENSOR */
	lm75b@48 {
		reg = <0x48>;
		compatible = "national,lm75b";
		vs-supply = <&reg_3p3v>;
	};
	/* HEAD ACCELEROMETER */
	head-accel@1e {
		reg = <0x1e>;
		compatible = "st,lis2hh12";
		vdd-supply = <&reg_3p3v>;
		vddio-supply = <&reg_3p3v>;
		mount-matrix = "1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "1";
	};
	/* CONTROL BOARD ACCELEROMETER */
	board-accel@1d {
		reg = <0x1d>;
		compatible = "st,lis2hh12";
		vdd-supply = <&reg_3p3v>;
		vddio-supply = <&reg_3p3v>;
		mount-matrix = "1", "0", "0",
			       "0", "1", "0",
			       "0", "0", "1";
	};
};

&iomuxc {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_hog>;

	glowforge {
		pinctrl_hog: hog {
			fsl,pins = <
				MX6QDL_PAD_CSI0_DAT8__GPIO5_IO26  WEAK_PULLDOWN /* WL_EN */
				MX6QDL_PAD_CSI0_DAT18__GPIO6_IO04 WEAK_PULLDOWN /* WL_IRQ */
			>;
		};

		pinctrl_uart1: glowforge_uart1 {
			fsl,pins = <
				MX6QDL_PAD_CSI0_DAT10__UART1_TX_DATA UART_PAD_CTRL
				MX6QDL_PAD_CSI0_DAT11__UART1_RX_DATA UART_PAD_CTRL
			>;
		};

		pinctrl_ecspi2: glowforge_ecspi2 {
			fsl,pins = <
				MX6QDL_PAD_EIM_OE__ECSPI2_MISO      SPI_PAD_CTRL
				MX6QDL_PAD_EIM_CS1__ECSPI2_MOSI     SPI_PAD_CTRL
				MX6QDL_PAD_EIM_CS0__ECSPI2_SCLK     (SPI_PAD_CTRL | PAD_CTL_PUS_100K_DOWN)
				MX6QDL_PAD_DI0_DISP_CLK__GPIO4_IO16 WEAK_PULLUP
			>;
		};

		pinctrl_cnc: glowforge_cnc {
			fsl,pins = <
				MX6QDL_PAD_GPIO_7__GPIO1_IO07	   WEAK_PULLUP	/* BUTTON_LATCH_RST */
				MX6QDL_PAD_EIM_A21__GPIO2_IO17   WEAK_PULLUP	/* STEP_Z_DIR */
				MX6QDL_PAD_EIM_A20__GPIO2_IO18   WEAK_PULLUP	/* Y1_DIR */
				MX6QDL_PAD_EIM_A19__GPIO2_IO19   WEAK_PULLUP	/* X_DIR */
				MX6QDL_PAD_EIM_A18__GPIO2_IO20   WEAK_PULLUP	/* Y1_STEP */
				MX6QDL_PAD_EIM_A17__GPIO2_IO21   WEAK_PULLUP	/* STEP_Z_STEP */
				MX6QDL_PAD_EIM_A16__GPIO2_IO22   WEAK_PULLUP	/* X_STEP */
				MX6QDL_PAD_EIM_EB0__GPIO2_IO28   WEAK_PULLUP	/* Y2_DIR */
				MX6QDL_PAD_EIM_EB1__GPIO2_IO29   WEAK_PULLUP	/* Y2_STEP */
				MX6QDL_PAD_EIM_EB2__GPIO2_IO30   (WEAK_PULLUP | MUX_MODE_SION)	/* LASER_ENABLE, SION enabled */
				MX6QDL_PAD_EIM_EB3__GPIO2_IO31   WEAK_PULLUP	/* LASER_ON_HEAD */
				MX6QDL_PAD_EIM_DA1__GPIO3_IO01   (WEAK_PULLUP | MUX_MODE_SION)	/* X_MODE1, SION enabled */
				MX6QDL_PAD_EIM_DA2__GPIO3_IO02   WEAK_PULLUP	/* Y1_ENBL */
				MX6QDL_PAD_EIM_DA3__GPIO3_IO03   (WEAK_PULLUP | MUX_MODE_SION)	/* X_MODE2, SION enabled */
				MX6QDL_PAD_EIM_DA4__GPIO3_IO04   (WEAK_PULLUP | MUX_MODE_SION)	/* Y_MODE0, SION enabled */
				MX6QDL_PAD_EIM_DA5__GPIO3_IO05   (WEAK_PULLUP | MUX_MODE_SION)	/* X_MODE0, SION enabled */
				MX6QDL_PAD_EIM_DA6__GPIO3_IO06   WEAK_PULLUP	/* X_HOME, no pulldown or pullup */
				MX6QDL_PAD_EIM_DA7__GPIO3_IO07   (WEAK_PULLUP | MUX_MODE_SION)	/* Y_DECAY, SION enabled */
				MX6QDL_PAD_EIM_DA8__GPIO3_IO08   WEAK_PULLUP	/* Y1_FAULT */
				MX6QDL_PAD_EIM_DA9__GPIO3_IO09   WEAK_PULLUP	/* Y2_HOME */
				MX6QDL_PAD_EIM_DA10__GPIO3_IO10  WEAK_PULLUP	/* Y1_HOME */
				MX6QDL_PAD_EIM_DA11__GPIO3_IO11  WEAK_PULLUP	/* Y2_ENBL */
				MX6QDL_PAD_EIM_DA12__GPIO3_IO12  (WEAK_PULLUP | MUX_MODE_SION)	/* Y_MODE1, SION enabled */
				MX6QDL_PAD_EIM_DA13__GPIO3_IO13  (WEAK_PULLUP | MUX_MODE_SION)	/* Y_MODE2, SION enabled */
				MX6QDL_PAD_EIM_DA14__GPIO3_IO14  WEAK_PULLUP	/* Y2_FAULT */
				MX6QDL_PAD_EIM_D16__GPIO3_IO16   WEAK_PULLUP	/* STEP_SLEEP */
				MX6QDL_PAD_EIM_D18__GPIO3_IO18   WEAK_PULLUP	/* /STEP_RESET */
				MX6QDL_PAD_EIM_D23__GPIO3_IO23   (WEAK_PULLUP | MUX_MODE_SION)	/* X_DECAY, SION enabled */
				MX6QDL_PAD_EIM_D24__GPIO3_IO24   (WEAK_PULLUP | MUX_MODE_SION)	/* CHARGE_PUMP, SION enabled */
				MX6QDL_PAD_EIM_D26__GPIO3_IO26   WEAK_PULLUP	/* /X_FAULT, no pulldown or pullup */
				MX6QDL_PAD_EIM_D27__GPIO3_IO27   WEAK_PULLUP	/* X_ENBL */
				MX6QDL_PAD_KEY_ROW0__GPIO4_IO07  WEAK_PULLUP	/* !BEAM_DET_TIMEOUT */
				MX6QDL_PAD_KEY_COL1__GPIO4_IO08  WEAK_PULLUP	/* !BEAM_DET_XOR */
				MX6QDL_PAD_KEY_COL2__GPIO4_IO10  WEAK_PULLUP	/* BEAM_DET_ERR */
				MX6QDL_PAD_KEY_ROW4__GPIO4_IO15  WEAK_PULLUP	/* !BEAM_DET */
				MX6QDL_PAD_GPIO_18__GPIO7_IO13   WEAK_PULLUP	/* BEAM_DET_LATCH_RST */
				/* laser-safety-chain readback inputs */
				MX6QDL_PAD_GPIO_3__GPIO1_IO03     WEAK_PULLUP	/* BUTTON_LATCH */
				MX6QDL_PAD_GPIO_5__GPIO1_IO05     WEAK_PULLUP	/* LASER_ON */
				MX6QDL_PAD_GPIO_19__GPIO4_IO05    (PAD_CTL_HYS | PAD_CTL_SPEED_MED | PAD_CTL_DSE_40ohm | MUX_MODE_SION)	/* INTERLOCK_LATCH_RESET, no pull, SION */
				MX6QDL_PAD_DISP0_DAT0__GPIO4_IO21 (PAD_CTL_HYS | PAD_CTL_SPEED_MED | PAD_CTL_DSE_40ohm)	/* LASER_PGOOD, no pull */
				MX6QDL_PAD_GPIO_8__GPIO1_IO08     (PAD_CTL_HYS | PAD_CTL_SPEED_MED | PAD_CTL_DSE_40ohm)	/* !CP_WD_ALIVE (inverted one-shot Q), no pull */
			>;
		};

		pinctrl_thermal: glowforge_thermal {
			fsl,pins = <
				MX6QDL_PAD_DI0_PIN4__GPIO4_IO20    WEAK_PULLUP	/* FAN_TACH_INTAKE1 */
				MX6QDL_PAD_DISP0_DAT2__GPIO4_IO23  WEAK_PULLUP	/* FAN_TACH_INTAKE2 */
				MX6QDL_PAD_NANDF_ALE__GPIO6_IO08   (WEAK_PULLUP | MUX_MODE_SION)	/* WATER_ON, SION enabled */
				MX6QDL_PAD_NANDF_RB0__GPIO6_IO10   (WEAK_PULLUP | MUX_MODE_SION)	/* TEC_ON, SION enabled */
				MX6QDL_PAD_SD4_CMD__GPIO7_IO09     (WEAK_PULLUP | MUX_MODE_SION)	/* WATER_HEATER_ON, SION enabled */
				MX6QDL_PAD_SD4_DAT0__GPIO2_IO08    WEAK_PULLUP	/* FAN_TACH_EXHAUST */
			>;
		};

		pinctrl_12v: glowforge_12v {
			fsl,pins = <MX6QDL_PAD_DISP0_DAT14__GPIO5_IO08 WEAK_PULLUP>;
		};

		pinctrl_40v: glowforge_40v {
			fsl,pins = <MX6QDL_PAD_DISP0_DAT23__GPIO5_IO17 WEAK_PULLUP>;
		};

		pinctrl_i2c1: glowforge_i2c1 {
			fsl,pins = <
				MX6QDL_PAD_EIM_D21__I2C1_SCL   I2C_PAD_CTRL	/* SION enabled */
				MX6QDL_PAD_EIM_D28__I2C1_SDA   I2C_PAD_CTRL	/* SION enabled */
			>;
		};

		/* The camera-select line is muxed by the node that drives it. */
		pinctrl_cam_mux: glowforge_cam_mux {
			fsl,pins = <
				MX6QDL_PAD_SD4_CLK__GPIO7_IO10 WEAK_PULLUP	/* CAM_SEL */
			>;
		};

		pinctrl_i2c2: glowforge_i2c2 {
			fsl,pins = <
				MX6QDL_PAD_KEY_COL3__I2C2_SCL   I2C_PAD_CTRL	/* SION enabled */
				MX6QDL_PAD_KEY_ROW3__I2C2_SDA   I2C_PAD_CTRL	/* SION enabled */
			>;
		};

		pinctrl_i2c4: glowforge_i2c4 {
			fsl,pins = <
				MX6QDL_PAD_NANDF_WP_B__I2C4_SCL I2C_PAD_CTRL	/* OD, SION enabled */
				MX6QDL_PAD_NANDF_CS3__I2C4_SDA  I2C_PAD_CTRL	/* OD, SION enabled */
			>;
		};

		pinctrl_usdhc1: glowforge_usdhc1 {
			fsl,pins = <
				MX6QDL_PAD_SD1_CMD__SD1_CMD    USDHC_SDIO_PAD_CTRL
				MX6QDL_PAD_SD1_CLK__SD1_CLK    USDHC_SDIO_CLK_PAD_CTRL
				MX6QDL_PAD_SD1_DAT0__SD1_DATA0 USDHC_SDIO_PAD_CTRL
				MX6QDL_PAD_SD1_DAT1__SD1_DATA1 USDHC_SDIO_PAD_CTRL
				MX6QDL_PAD_SD1_DAT2__SD1_DATA2 USDHC_SDIO_PAD_CTRL
				MX6QDL_PAD_SD1_DAT3__SD1_DATA3 USDHC_SDIO_PAD_CTRL
			>;
		};

		pinctrl_usdhc2: glowforge_usdhc2 {
			fsl,pins = <
				MX6QDL_PAD_SD2_CMD__SD2_CMD    USDHC_PAD_CTRL
				MX6QDL_PAD_SD2_CLK__SD2_CLK    USDHC_CLK_PAD_CTRL
				MX6QDL_PAD_SD2_DAT0__SD2_DATA0 USDHC_PAD_CTRL
				MX6QDL_PAD_SD2_DAT1__SD2_DATA1 USDHC_PAD_CTRL
				MX6QDL_PAD_SD2_DAT2__SD2_DATA2 USDHC_PAD_CTRL
				MX6QDL_PAD_SD2_DAT3__SD2_DATA3 0x13059	/* 100k pull-down, as the factory tree */
			>;
		};

		pinctrl_usdhc3: usdhc3grp {
			fsl,pins = <
				MX6QDL_PAD_SD3_CMD__SD3_CMD    USDHC_PAD_CTRL
				MX6QDL_PAD_SD3_CLK__SD3_CLK    USDHC_CLK_PAD_CTRL
				MX6QDL_PAD_SD3_DAT0__SD3_DATA0 USDHC_PAD_CTRL
				MX6QDL_PAD_SD3_DAT1__SD3_DATA1 USDHC_PAD_CTRL
				MX6QDL_PAD_SD3_DAT2__SD3_DATA2 USDHC_PAD_CTRL
				MX6QDL_PAD_SD3_DAT3__SD3_DATA3 USDHC_PAD_CTRL
				MX6QDL_PAD_SD3_DAT4__SD3_DATA4 USDHC_PAD_CTRL
				MX6QDL_PAD_SD3_DAT5__SD3_DATA5 USDHC_PAD_CTRL
				MX6QDL_PAD_SD3_DAT6__SD3_DATA6 USDHC_PAD_CTRL
				MX6QDL_PAD_SD3_DAT7__SD3_DATA7 USDHC_PAD_CTRL
				MX6QDL_PAD_SD3_RST__SD3_RESET  WEAK_PULLUP
			>;
		};

		pinctrl_pwm1: glowforge_pwm1 {
			fsl,pins = <
				MX6QDL_PAD_DISP0_DAT8__PWM1_OUT 0x1b0b8	/* FAN_PWM_INTAKE, strong drive */
			>;
		};

		pinctrl_pwm2: glowforge_pwm2 {
			fsl,pins = <
				MX6QDL_PAD_DISP0_DAT9__PWM2_OUT 0x1b0b8	/* LASER_PWM, strong drive */
			>;
		};

		pinctrl_pwm4: glowforge_pwm4 {
			fsl,pins = <
				MX6QDL_PAD_SD4_DAT2__PWM4_OUT 0x1b0b8	/* FAN_PWM_EXHAUST, strong drive */
			>;
		};

		pinctrl_switches: glowforge_switches {
			fsl,pins = <
				MX6QDL_PAD_KEY_COL4__GPIO4_IO14    0x100b0	/* !DOOR_SW1 */
				MX6QDL_PAD_GPIO_6__GPIO1_IO06      0x100b0	/* !DOOR_SW2 */
				MX6QDL_PAD_KEY_ROW1__GPIO4_IO09    0x100b0	/* !PAUSE (button pressed) */
				MX6QDL_PAD_GPIO_0__GPIO1_IO00      0x100b0	/* !DOOR_SW */
				MX6QDL_PAD_KEY_COL0__GPIO4_IO06    0x100b0	/* /HV_ENABLE readback (factory: ESTOP) */
				MX6QDL_PAD_GPIO_9__GPIO1_IO09      0x100b0	/* INTERLOCK */
				MX6QDL_PAD_GPIO_2__GPIO1_IO02      0x100b0	/* INTERLOCK_LATCH, no pulldown or pullup */
				MX6QDL_PAD_EIM_D22__GPIO3_IO22     WEAK_PULLUP	/* HEAD_IRQ, pullup */
			>;
		};

		pinctrl_outputs: glowforge_outputs {
			fsl,pins = <
				MX6QDL_PAD_NANDF_CLE__GPIO6_IO07  WEAK_PULLUP	/* CAM_!OE */
			>;
		};
	};
};

&pwm1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm1>;
	status = "okay";
};

&pwm2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm2>;
	/* LASER_PWM carrier: glowforge.ko programs a ~1925 ns period so the
	 * SDMA script can write raw 7-bit power levels straight into PWMSAR;
	 * the extra prescaler (0009 patch, factory 1001 mechanism) stretches
	 * the output to ~25 us, about 40 kHz, the carrier the laser PSU expects,
	 * without changing the valid duty range. NOT audio-related: the factory
	 * 4.14 tree carried this exact property on the laser PWM. */
	fsl,extra-prescale = <13>;
	status = "okay";
};

&pwm4 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_pwm4>;
	status = "okay";
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart1>;
	status = "okay";
};

/* No consumer. Left disabled so the pulse ring stays the SDMA's only
 * client: the imx serial driver would take two SDMA channels. */
&uart2 {
	status = "disabled";
};

/* WL1805 */
&usdhc1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc1>;
	bus-width = <4>;
	no-1-8-v;
	keep-power-in-suspend;
	enable-sdio-wakeup;
	vmmc-supply = <&reg_wlan>;
	non-removable;
	cap-power-off-card;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;
	wlcore: wlcore@2 {
		compatible = "ti,wl1805";
		reg = <2>;
		interrupt-parent = <&gpio6>;
		interrupts = <4 IRQ_TYPE_EDGE_RISING>;
	};
};

/* SD card */
&usdhc2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc2>;
	broken-cd;
	no-1-8-v;
	keep-power-in-suspend;
	enable-sdio-wakeup;
	status = "okay";
};

/* eMMC */
&usdhc3 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usdhc3>;
	bus-width = <8>;
	non-removable;
	no-1-8-v;
	keep-power-in-suspend;
	status = "okay";
};

/*
 * EPIT timers: motion path. imx6qdl.dtsi defines the epit1/epit2 nodes
 * (reg + interrupts) but no compatible; bind them to the ForgeFIRM EPIT API
 * driver (CONFIG_MXC_EPIT_API). These clock the SDMA step-stream playback.
 */
&epit1 {
	compatible = "fsl,imx6qdl-epit";
	id = <0>;
	clocks = <&clks IMX6QDL_CLK_EPIT1>;
	clock-names = "epit1";
	sdma-event = <16>;
	status = "okay";
};

&epit2 {
	compatible = "fsl,imx6qdl-epit";
	id = <1>;
	clocks = <&clks IMX6QDL_CLK_EPIT2>;
	clock-names = "epit2";
	sdma-event = <9>; /* note: requires bit 5 set in IOMUXC_GPR0 */
	sdma-event-select = <&gpr 0 0x20 0x20>;
	status = "okay";
};

/* MIPI CSI-2 receiver: input is the video-mux output (selected lid/head). */
&mipi_csi {
	status = "okay";

	port@0 {
		reg = <0>;
		mipi_csi2_in: endpoint {
			remote-endpoint = <&vmux_out>;
			clock-lanes = <0>;
			data-lanes = <1 2>;
		};
	};
};
/* (imx6dl.dtsi already wires mipi_csi virtual channels -> the IPU CSI muxes.) */

/*
 * SoC blocks the dtsi leaves enabled that this board does not use. No USB
 * controller is enabled, so the two USB PHYs, their dummy regulators, and
 * usbmisc have nothing to serve; the audio sample-rate converter has no
 * audio path behind it.
 */
&asrc {
	status = "disabled";
};

&usbphy1 {
	status = "disabled";
};

&usbphy2 {
	status = "disabled";
};

&usbphynop1 {
	status = "disabled";
};

&usbphynop2 {
	status = "disabled";
};

&usbmisc {
	status = "disabled";
};
